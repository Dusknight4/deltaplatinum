field_sprites_nsbtxs += field_sprites_pokemon_hg_import

field_sprites_nsbmds = copy_gen.process(files(
    'models/generic_32x32.nsbmd',
    'models/generic_16x16.nsbmd',
    'models/rock_smash.nsbmd',
