field_sprites_frame_seqs = copy_gen.process(files(
    'frame_sequences/generic_walk.bin',
    'frame_sequences/walk_and_run.bin',
    'frame_sequences/berry_tree.bin',
    'frame_sequences/bike.bin',
    'frame_sequences/holding_poke_ball.bin',
